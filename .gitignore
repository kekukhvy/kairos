# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
# ...but the Gradle wrapper jar MUST be tracked — Docker/CI builds run ./gradlew
# and fail without it ("Unable to access jarfile gradle-wrapper.jar").
!gradle/wrapper/gradle-wrapper.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*
/.gradle/
/.idea/
# Gradle/IDE build output in any module (root or nested), not just a hand-listed few.
**/build/
**/out/
**/target/
/src/
/kairos-admin/src/main/frontend/generated/
